{
  "name": "ui-src",
  "version": "1.0.0",
  "description": "",
  "license": "CC0-1.0",
  "author": "",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "coverage": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --setupFiles dotenv/config --coverage",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --setupFiles dotenv/config",
    "watchTest": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --setupFiles dotenv/config --watch",
    "a11y": "pa11y --runner axe --runner htmlcs"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@cmsgov/design-system": "^13.1.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^2.9.11",
    "aws-amplify": "~6.20.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^4.1.17",
    "html-react-parser": "^5.2.17",
    "launchdarkly-react-client-sdk": "^3.9.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^3.1.4",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^4.12.0",
    "react-router": "^8.3.0",
    "sass": "^1.84.0",
    "yup": "^0.32.11",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.2.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-helmet": "^6.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "jest": "^30.4.2",
    "jest-axe": "^6.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-launchdarkly-mock": "^2.2.1",
    "pa11y": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/components/**/*.{ts,tsx}",
      "!src/components/index.ts*",
      "src/routes/**/*.{ts,tsx}",
      "!src/routes/index.tsx",
      "!src/types/index.ts*",
      "src/utils/**/*.{ts,tsx}",
      "!src/utils/testing/*",
      "!src/utils/index.ts*",
      "!src/utils/**/index.ts*"
    ],
    "coverageReporters": [
      "json",
      [
        "lcov",
        {
          "projectRoot": "../../"
        }
      ],
      "text",
      "text-summary"
    ],
    "globals": {
      "_env_": {}
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|webp|svg|mp4|webm|wav|mp3|m4a)$": "<rootDir>/src/utils/testing/mockAsset.ts",
      "^.+\\.(css|less|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "jest-launchdarkly-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/utils/testing/setupJest.tsx"
    ],
    "testEnvironment": "<rootDir>/src/utils/testing/testEnv.js",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest",
        {
          "jsc": {
            "transform": {
              "react": {
                "runtime": "automatic"
              }
            }
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "<rootDir>/../../node_modules/(?!(react-router|@react-router)/)",
      "node_modules/(?!(react-router|@react-router)/)"
    ],
    "verbose": true
  }
}
